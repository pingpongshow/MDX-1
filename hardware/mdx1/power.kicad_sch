	(text "MDX-1  POWER TREE"
		(exclude_from_sim no)
		(at 15.24 21.59 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "1096a848-df43-4c65-9371-c94f513b61bf")
	)
	(text "1S Li-ion 21700 (5 Ah) -> BQ24075 power-path charger (USB-C 5 V) -> VSYS.  VSYS -> TPS63001 buck-boost +3V3 (digital);"
		(exclude_from_sim no)
		(at 15.24 26.67 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "31e52525-d8f1-4f28-be1c-d5f96ab5c794")
	)
	(text "VTX = 1.6V*(1+442k/40.2k+442k/66.5k) - VDAC*(442k/66.5k)  ->  29.8 V @ 0 V DAC, 7.9 V @ 3.3 V DAC.   VBRIDGE = 1.6V*(1+1.238M/20k) = 100.6 V."
		(exclude_from_sim no)
		(at 15.24 444.5 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "63d279e2-d408-40ca-a8dc-6babb314dbbc")
	)
	(text "Capacitors drawn at a pin belong to that pin (PCB placement follows the schematic)."
		(exclude_from_sim no)
		(at 15.24 39.37 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "8dc3244a-c6e3-4b3c-9aaa-2a67494bfb87")
	)
	(text "LT3757 #1: VSYS -> VTX programmable 8..30 V (DAC-steered feedback) = VLF transmit rail.  LT3757 #2: VTX -> VBRIDGE 100 V for PI/ZVT mode (off in VLF: VBRIDGE = VTX - Vf)."
		(exclude_from_sim no)
		(at 15.24 35.56 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "9f2d16bb-3e71-49f5-beb2-430dab97530a")
	)
	(text "+5V_LCD: the memory LCD is a 5 V panel (VDD 4.8-5.5 V, VIH 2.7 V min, so 3.3 V logic is fine); 10R/10u keeps its refresh current off the analog rail."
		(exclude_from_sim no)
		(at 234.442 442.214 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "a1a85185-94ab-48a5-b3dc-ce7da90a5ed2")
	)
	(text "HV_BLEED: MCU discharges the 100 V bank (27 uF, 0.13 J) through 10k (1 W pulse rated) in ~1.4 s when leaving PI mode."
		(exclude_from_sim no)
		(at 15.24 449.58 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "c38b137c-99e9-4114-8581-1a3bf8c62481")
	)
	(text "TPS65131 -> +12V (gate drivers, feeds LT3045 +5VA ultra-low-noise LDO) and -6V (feeds LT3094 -5VA LDO); TPS7A20 -> +3V3A (ADC/ref)."
		(exclude_from_sim no)
		(at 15.24 30.48 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "f989e34a-b3b7-4510-9cdd-b72675a7cbb5")
	)
