	(text "Display, keys, LEDs and front-light live on a separate UI board (sheet 7) linked by a 20-way 0.5 mm FFC; the front-light MOSFET driver, LSM6DSM IMU, audio and radios stay on the main board."
		(exclude_from_sim no)
		(at 15.24 26.67 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "1993e33a-8f02-4ee3-805d-396716f26ef8")
	)
	(text "Antenna: 50 ohm trace, series 0R and shunt DNP pads for the matching network the antenna vendor recommends for this ground-plane size."
		(exclude_from_sim no)
		(at 250.19 394.97 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "6082caaf-0930-4824-8d5b-5c7e17d5c756")
	)
	(text "Key inputs use the MCU pull-ups; keys switch to GND on the UI board. FL_K is the front-light cathode, switched here by Q_FL (PWM)."
		(exclude_from_sim no)
		(at 15.24 165.1 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "8abbbf9d-dc78-4eb3-ade5-015aad70bf96")
	)
	(text "USER INTERFACE, AUDIO AND RADIO"
		(exclude_from_sim no)
		(at 15.24 21.59 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "a344b622-2bed-4c99-9fd7-6c5c1f6b06db")
	)
	(text "Audio: DAC -> 7 kHz RC -> TPA6132A2 headphone amp (cap-free) and PAM8302 class-D speaker; I2S to a BM83-class Bluetooth 5 audio module (low-latency codec) for wireless phones."
		(exclude_from_sim no)
		(at 15.24 30.48 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "fc494fe8-a4a6-4836-917c-c901941d8f71")
	)
