	(text "Sharp LS027B7DH01 memory LCD (400x240, 5 V panel, 3.3 V logic). Keys: MENU (short = menu/enter, hold 0.8 s = back), UP/DOWN, LEFT/RIGHT, PINPOINT trigger (hold 1.5 s = ground grab), POWER (hold 1.5 s = off, wakes the MCU)."
		(exclude_from_sim no)
		(at 15.24 26.67 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "26fb265e-6c90-4bbc-a4cb-a9a24304efed")
	)
	(text "PINPOINT is a trigger-style switch under the handle; the other six are the front keypad. Four M2.5 holes; the LCD is bonded to the board with its FPC folded into J_LCD."
		(exclude_from_sim no)
		(at 15.24 265.43 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "a74ea24c-6e95-4957-adb2-a8cd10ba111a")
	)
	(text "UI BOARD  (separate 2-layer PCB behind the display window; 20-way FFC to the main board)"
		(exclude_from_sim no)
		(at 15.24 21.59 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "d1447c7a-925c-4a96-a0e7-f72359e56b1b")
	)
	(text "Every net on this sheet is a global label shared with the UI link connector on sheet 6. FFC: 20-way 0.5 mm, same-side contacts (type A), pin 1 to pin 1."
		(exclude_from_sim no)
		(at 15.24 30.48 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "ed8a4abd-1762-4363-8b7d-fe7c1a3992a3")
	)
