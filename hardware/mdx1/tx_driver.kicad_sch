	(text "TX_FAULT (active high, wired-OR) -> TIM1 BKIN: hardware shuts all four gates off within one timer clock, independent of firmware."
		(exclude_from_sim no)
		(at 15.24 350.52 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "60d414bf-540c-457e-8fc5-ee6bf8d06379")
	)
	(text "In-line 20 mOhm shunt + INA241A2 (-5..+110 V common mode, 1.1 MHz) gives the TX current reference ITX (0.4 V/A around 2.5 V) for software normalisation VRX/ITX."
		(exclude_from_sim no)
		(at 15.24 35.56 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "94bdcffa-2e3b-47cd-b174-48272c953107")
	)
	(text "Gate resistors 4R7 -> ~40 ns edges; dead time set in TIM1 BDTR (100 ns).  Bridge decoupling (4u7 + 100n 200 V) sits at the high-side drains."
		(exclude_from_sim no)
		(at 15.24 355.6 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "984a60ea-c060-4ca2-9a7d-5ff2bff64578")
	)
	(text "VLF mode: VBRIDGE = 8..30 V, TIM1 CH1/CH1N + CH2/CH2N (dead-time 100 ns) synthesise the optimised 3-level 5-frequency waveform (LUT, 2.44 us edge slots)."
		(exclude_from_sim no)
		(at 15.24 26.67 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "c9df05da-3837-43bc-8751-e5ff38b4f3aa")
	)
	(text "TX H-BRIDGE  (150 V MOSFETs, UCC27714 600 V half-bridge drivers, bootstrap high side)"
		(exclude_from_sim no)
		(at 15.24 21.59 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "e33626d1-4f9d-42ce-9954-d2d01e2151b3")
	)
	(text "PI/ZVT mode: VBRIDGE = 100 V; fast current reversal through the bridge, zero-voltage hold by low-side freewheel (Q5+Q7 on) with PWM top-up under current feedback."
		(exclude_from_sim no)
		(at 15.24 30.48 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "fe4c299f-e43c-4e77-b94c-ccc6cda207f6")
	)
