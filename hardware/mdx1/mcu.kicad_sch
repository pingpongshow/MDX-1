	(text "SAI1 block B (PF8 SCK, PF9 FS, PF6 SD) is the ADC data interface: TDM master, 32.768 MHz bit clock from PLL2, 512 kHz frame sync, two 32-bit slots per frame, circular DMA."
		(exclude_from_sim no)
		(at 15.24 30.48 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "00f40c72-77a2-47a0-b91c-e079b0d5919f")
	)
	(text "All sampling, transmit timing and demodulation are derived from the single crystal -> fully coherent; noise-cancel shifts the TX fundamental by re-scaling the LUT period."
		(exclude_from_sim no)
		(at 15.24 35.56 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "4bcfac13-e56a-4ad1-8742-2c13e78cacd3")
	)
	(text "HSE 16.384 MHz -> PLL1 (458.752 MHz SYSCLK) and MCO2 = HSE = 16.384 MHz to both ADCs. TIM1 (229.376 MHz) generates the TX waveform: 44800 ticks per 195.3125 us period."
		(exclude_from_sim no)
		(at 15.24 26.67 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "9cc9bd62-e6ea-4c4d-90cb-63dfb9cabdf2")
	)
	(text "Unused GPIO are left open (ERC no-connect).  SD in 1-bit SDMMC mode (PC9 is reserved for MCO2 -> ADC clock).  PC13 = WKUP4."
		(exclude_from_sim no)
		(at 15.24 405.13 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "a1d2f6cc-d1c5-467d-a2ae-ee359b8138e8")
	)
	(text "PROCESSOR  STM32H743ZIT6  (Cortex-M7 480 MHz, double-precision FPU, 2 MB flash, 1 MB RAM)"
		(exclude_from_sim no)
		(at 15.24 21.59 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "eb6866d1-b8a5-4d39-b759-d77757e269d7")
	)
